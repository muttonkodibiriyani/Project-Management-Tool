# The landing-zone values deploy.sh needs. Each starts as a placeholder in angle brackets, and
# deploy.sh refuses to run while any is left. Replace each one with the value the platform team or
# Cloud Security gives (the landing-zone doc in tm8, 01a188ce-91e6), in a copy in Cloud Shell, and
# never commit the filled-in copy. One NAME=value per line; no quotes, no spaces around '='.

# The subscription and the existing resource group, in UAE North.
SUBSCRIPTION_ID=<landing-zone: subscription ID>
RESOURCE_GROUP=<landing-zone: resource group name>

# The spoke address range from IPAM, /22 or wider (for example 10.x.y.0/22).
VNET_ADDRESS_PREFIX=<landing-zone: IPAM range, /22 or wider>
# The hub DNS resolver addresses, comma-separated, or azure to use Azure DNS.
DNS_SERVERS=<landing-zone: hub DNS resolver IPs, or azure>
# The hub firewall's private IP: the next hop for all of the app's outbound traffic.
HUB_FIREWALL_IP=<landing-zone: hub firewall private IP>

# Resource IDs of the landing zone's private DNS zones.
POSTGRES_DNS_ZONE_ID=<landing-zone: privatelink.postgres.database.azure.com zone ID>
BLOB_DNS_ZONE_ID=<landing-zone: privatelink.blob.core.windows.net zone ID>
KEYVAULT_DNS_ZONE_ID=<landing-zone: privatelink.vaultcore.azure.net zone ID>
REGISTRY_DNS_ZONE_ID=<landing-zone: privatelink.azurecr.io zone ID>

# private-endpoint or vnet-integration (open question Q8).
POSTGRES_NETWORKING=<landing-zone: private-endpoint or vnet-integration>
# create, or the resource ID of the landing zone's container registry.
REGISTRY=<landing-zone: create, or registry resource ID>

# The Entra app registration for sign-in. Its redirect URI is the app's address, which the first
# deploy prints once the infrastructure exists; the identity team registers it then.
ENTRA_TENANT_ID=<landing-zone: tenant ID>
ENTRA_CLIENT_ID=<landing-zone: app registration client ID>
# managed-identity (option A) or certificate (option B), open question Q3.
ENTRA_CREDENTIAL=<landing-zone: managed-identity or certificate>

# Object IDs of the Entra groups assigned to each app role.
GROUP_WORKSPACE_ADMIN=<landing-zone: Workspace admin group object ID>
GROUP_LAUNCH_MANAGER=<landing-zone: Launch manager group object ID>
GROUP_BRAND_TEAM=<landing-zone: Brand team group object ID>
GROUP_SUPPLY=<landing-zone: Supply group object ID>
GROUP_VM=<landing-zone: VM group object ID>
GROUP_COMMS=<landing-zone: Comms group object ID>
GROUP_VIEWER=<landing-zone: Viewer group object ID>

# Where Cloud Security accepted the POC exceptions (one app replica, no zone-redundant environment or database),
# for example a ticket number. Nothing deploys before they are accepted.
POC_EXCEPTIONS_ACCEPTED=<landing-zone: reference to the accepted POC exceptions>
