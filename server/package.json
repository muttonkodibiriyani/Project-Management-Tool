{
  "name": "launch-tracker-server",
  "version": "0.1.0",
  "private": true,
  "description": "Serves the Launch Tracker web app and its API, and holds the smoke test every environment runs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p . && node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "test": "npm run build && node --test --test-reporter=spec \"dist/**/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.8",
    "@fastify/type-provider-typebox": "6.3.0",
    "fastify": "5.12.7",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "sanitize-html": "2.18.1",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
